{
  "name": "@sulytwelve/dsh-memory-astra62",
  "version": "1.1.5",
  "description": "DSH Context Manager: context management for DeepSeek Harness — on-demand recall of project knowledge, evidence revalidation, and cross-session task resumption, split into independently toggleable perf tiers.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "memory",
    "agent-memory"
  ],
  "license": "BSD-2-Clause",
  "author": "Sulytwelve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sulytwelve/dsh-context-manager.git"
  },
  "homepage": "https://github.com/Sulytwelve/dsh-context-manager#readme",
  "bugs": {
    "url": "https://github.com/Sulytwelve/dsh-context-manager/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./distill": "./distill.js",
    "./probe": "./probe.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "distill.js",
    "probe.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/regression.mjs",
    "bench:setup": "node bench/setup.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
